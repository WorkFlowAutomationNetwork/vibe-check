# ============================================================
# apps/web (Next.js)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # Server-side only, never expose to client

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Cloudflare Turnstile (sign-up captcha) ---
# Optional. When unset, sign-up runs without a captcha (unchanged behaviour).
# When set, the widget renders on /sign-up and the token is verified by Supabase
# against the Turnstile *secret* configured in Auth → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=     # Public site key from the Cloudflare Turnstile widget

REDIS_URL=redis://localhost:6379

SCANNER_API_URL=http://localhost:8000
SCANNER_INTERNAL_KEY=               # Shared secret for web→scanner auth

RESEND_API_KEY=            # Resend API key
EMAIL_FROM=                # From address for transactional emails (e.g. noreply@vibe-check-app.com)

# --- GitHub App (committed-secret scanning) ---
GITHUB_APP_ID=                      # numeric App ID from the GitHub App settings
GITHUB_APP_SLUG=the-vibe-check-app  # App slug, used to build the install URL (github.com/apps/<slug>)
GITHUB_APP_CLIENT_ID=               # OAuth client id of the App
GITHUB_APP_CLIENT_SECRET=           # OAuth client secret; also signs the install CSRF state
GITHUB_APP_PRIVATE_KEY=             # PEM private key (escape newlines as \n)
GITHUB_WEBHOOK_SECRET=              # secret configured on the App webhook; verifies X-Hub-Signature-256

# --- Prelaunch gate (coming-soon password wall) ---
PRELAUNCH_LOCK_ENABLED=false        # true locks the whole site behind PRELAUNCH_PASSWORD; flip to false at launch
PRELAUNCH_PASSWORD=                 # shared dev/tester password; required when ENABLED=true

# ============================================================
# apps/scanner (Python FastAPI)
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379
SCANNER_INTERNAL_KEY=               # Must match web app value
NUCLEI_TEMPLATES_PATH=
MAX_CONCURRENT_SCANS=5
